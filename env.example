# All optional. With none set, the app runs fully on synthetic data with a
# simulated brain and deterministic embeddings — the demo works out of the box.

# Real agent brains (set either or both). Voice AI + Summarization use these.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_MODEL=gpt-4o-mini

# Live Voice (OpenAI Realtime). Uses OPENAI_API_KEY above. Optional overrides:
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

# Durable storage upgrade (Postgres + pgvector, e.g. Neon/Vercel Postgres).
# Leave blank to use the in-memory stores. See api/app/db.py for the schema.
DATABASE_URL=

# Optional observability: log governance traces + eval scores to Braintrust.
# Bolts on top of the built-in governance engine; leave blank for a no-op.
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=LTM Governed Contact Center
